# Copy to .env and adjust. This is a public address, not a secret.
# Address of the AMC Desk API (the server/ app), without a trailing slash.
# Local development: http://localhost:4000
# On Coolify: set VITE_API_URL as a build variable (e.g. https://api.yourdomain.com).
VITE_API_URL=http://localhost:4000
